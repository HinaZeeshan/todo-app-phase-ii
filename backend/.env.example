# ========================================
# Todo Backend API - Environment Configuration
# ========================================

# Database Configuration
# -----------------------
# Neon Serverless PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
# Neon Serverless PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/neondb
# Note: asyncpg connects with SSL by default for Neon

# Security - JWT Authentication
# -------------------------------
# Secret key for signing JWT tokens (MUST be at least 32 characters)
# CRITICAL: Generate a new secret for production. Never commit real secrets to git.
JWT_SECRET=O44EFS9ItmnFG57TKb5y9z0inwkVTw1HrWr3wj9mEOQ=
# Generate secure secret with: python -c "import secrets; print(secrets.token_urlsafe(32))" or openssl rand -base64 32

# JWT Algorithm (recommended: HS256)
JWT_ALGORITHM=HS256

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins for CORS
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example: https://app.example.com,https://www.example.com

# Application Settings
# --------------------
# Environment: development | staging | production
ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ========================================
# Notes:
# - Copy this file to .env and fill in real values
# - NEVER commit .env to version control
# - Use strong secrets in production
# - Keep DATABASE_URL connection string secure
# ========================================
REFRESH_TOKEN_EXPIRE_DAYS=7
