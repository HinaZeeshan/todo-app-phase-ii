# Database Configuration
# -----------------------
# Neon Serverless PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL='postgresql://neondb_owner:npg_k3tGVwSNXF7Z@ep-holy-sound-ahdoxmj3-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Example: postgresql+asyncpg://myuser:mypass@ep-cool-fire-12345.us-east-2.aws.neon.tech/neondb

# Security - JWT Authentication
# -------------------------------
# Secret key for signing JWT tokens (MUST be at least 32 characters)
# CRITICAL: Generate a new secret for production. Never commit real secrets to git.
JWT_SECRET=O44EFS9ItmnFG57TKb5y9z0inwkVTw1HrWr3wj9mEOQ=
# Generate secure secret with: python -c "import secrets; print(secrets.token_urlsafe(32))" or openssl rand -base64 32

# JWT Algorithm (recommended: HS256)
JWT_ALGORITHM=HS256

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins for CORS
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example: https://app.example.com,https://www.example.com

# Application Settings
# --------------------
# Environment: development | staging | production
ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ========================================
# Notes:
# - Copy this file to .env and fill in real values
# - NEVER commit .env to version control
# - Use strong secrets in production
# - Keep DATABASE_URL connection string secure
# ========================================
